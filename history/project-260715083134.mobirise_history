g.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\"></div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\" mbr-if=\"showTitle || showText\">\n            <div class=\"col-md-12 content-head mb-5\">\n                <h1 class=\"mbr-section-title mbr-fonts-style  mb-0\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>ÁREA DE ATENDIMENTO</b></h1>\n                <p class=\"mbr-text mbr-fonts-style mt-4 mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">\n                    Great for pro-coders for fast prototyping and small customers' projects.\n                </p>\n            </div>\n        </div>\n        <div class=\"row justify-content-center  blockContent\">\n            <div class=\"col-12 col-lg\">\n                <div class=\"item-wrapper align-left\">\n                    <div class=\"counter-container mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\" data-multiline mbr-article>\n                        <div style=\"text-align: left;\"><b>Atendemos presencialmente:</b></div><div style=\"text-align: left;\">Porto Alegre e Região Metropolitana</div><div style=\"text-align: left;\"><b><br></b></div><div style=\"text-align: left;\">Prestamos suporte técnico remoto e presencial para empresas e profissionais, garantindo atendimento rápido, especializado e com foco na continuidade das operações.</div><div style=\"text-align: left;\"><b><br></b></div><div style=\"text-align: left;\">Onde atendemos\n</div><div style=\"text-align: left;\"><b>Porto Alegre e Região Metropolitana</b></div><div style=\"text-align: left;\"><b><br></b></div><div style=\"text-align: left;\">Cidades atendidas:</div><div style=\"text-align: left;\"><b>PORTO ALEGRE</b></div><div style=\"text-align: left;\"><b>CANOAS</b></div><div style=\"text-align: left;\"><b>GRAVATAÍ</b></div><div style=\"text-align: left;\"><b>CACHOEIRINHA</b></div><div style=\"text-align: left;\"><b>ALVORADA</b></div><div style=\"text-align: left;\"><b>VIAMÃO</b></div><div style=\"text-align: left;\"><b>SÃO LEOPOLDO</b></div><div style=\"text-align: left;\"><b>NOVO HAMBURGO</b></div><div style=\"text-align: left;\"><b>ESTEIO</b></div><div style=\"text-align: left;\"><b>SAPUCAIA DO SUL</b></div><p><br></p><p><br></p><ul>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-{{imageWidth}}\">\n                <div class=\"image-wrapper\">\n                    <img class=\"w-100\" src=\"@PROJECT_PATH@/assets/images/ic-suporte02-1536x1024.png\" alt=\"DATADARK\">\n                </div>\n            </div>\n\n        </div>\n    </div>\n</section>",
